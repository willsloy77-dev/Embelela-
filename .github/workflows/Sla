
name: Importar Embele﻿la

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  importar:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Extrair projecto
        run: |
          mkdir -p /tmp/embelela
          unzip -q Embelela-Novo-Projecto-MVP.zip -d /tmp/embelela
          cp -R /tmp/embelela/Embelela/. .

      - name: Guardar alterações
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add -A
          git commit -m "Importar projecto Embele﻿la MVP"
          git push
